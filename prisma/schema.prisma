generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classes   Class[]  @relation("OwnerClasses")
}

model Class {
  id          String    @id @default(cuid())
  name        String
  description String?
  nextNo      Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerId   String?
  owner     User?     @relation("OwnerClasses", fields: [ownerId], references: [id])

  students  Student[]
  lessons   Lesson[]
  contents  Content[]
}

model Student {
  id        String   @id @default(cuid())
  classId   String
  name      String
  cpf       String?  // novo campo opcional
  contact   String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class     Class    @relation(fields: [classId], references: [id])

  @@index([classId])
}

model Lesson {
  id        String   @id @default(cuid())
  classId   String
  number    Int
  date      DateTime @default(now())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class     Class    @relation(fields: [classId], references: [id])
  content   Content?

  @@unique([classId, number])
  @@index([classId])
}

model Content {
  id              String   @id @default(cuid())
  classId         String
  lessonId        String?  @unique
  title           String
  text            String   @db.Text
  objetivos       String?  @db.Text
  desenvolvimento String?  @db.Text
  recursos        String?  @db.Text
  bncc            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  lesson  Lesson? @relation(fields: [lessonId], references: [id])

  @@index([classId])
}
